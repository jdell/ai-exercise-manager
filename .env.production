# ---------------------------------------------------------------------------
# Production Firebase config for the `yk-ai-course` project.
#
# Every VITE_* value here is embedded in the built JavaScript bundle and is
# therefore PUBLIC by design — this is the Firebase *web* config, not a secret.
# That is why this file is committed rather than gitignored. The two real
# secrets (ANTHROPIC_API_KEY, TEACHER_SIGNUP_CODE) live in Secret Manager and
# are read only by the Cloud Functions. Never add one here.
#
# These values come from the Firebase console:
#   Project settings -> Your apps -> Web app -> SDK setup and configuration
#
# Vite prefers .env.production over .env.local for `vite build`, so a stale
# value here will NOT be rescued by a filled-in .env.local.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIzaSyC6gwBn-e6rvbIjiVfOQ9cKX93UlJpWwNA
VITE_FIREBASE_AUTH_DOMAIN=yk-ai-course.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://yk-ai-course-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=yk-ai-course
VITE_FIREBASE_STORAGE_BUCKET=yk-ai-course.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=381769863581
VITE_FIREBASE_APP_ID=1:381769863581:web:af6c1559fd201d6bbddf74

# Must match setGlobalOptions() in functions/src/index.ts, or every call 404s.
VITE_FUNCTIONS_REGION=us-central1

# Never point a production build at the local emulator suite.
VITE_USE_EMULATORS=false
