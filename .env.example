# ---------------------------------------------------------------------------
# AI Skills Exercise Manager — web app configuration
# Copy to `.env.local` and fill in. Every VITE_* value is embedded in the built
# JavaScript bundle and is therefore PUBLIC. Never put a secret here.
#
# The two real secrets — the Anthropic API key and the teacher signing code —
# live in Firebase Secret Manager and are read only by the Cloud Functions.
# See "Server-side secrets" at the bottom of this file.
# ---------------------------------------------------------------------------

# --- Firebase (required) ----------------------------------------------------
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup.
# There is no backend-free mode: Authentication, the database rules, and the
# Cloud Function that talks to Claude are the app's security model.
VITE_FIREBASE_API_KEY=AIzaSyEXAMPLE-replace-with-your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Cloud Functions --------------------------------------------------------
# Must match setGlobalOptions() in functions/src/index.ts, or every call 404s.
VITE_FUNCTIONS_REGION=us-central1

# --- Local development ------------------------------------------------------
# Point Auth, Realtime Database, and Functions at the local emulator suite
# (`npm run emulators`) instead of your real project. Leave unset otherwise.
VITE_USE_EMULATORS=false

# ---------------------------------------------------------------------------
# Server-side secrets — NOT set here
# ---------------------------------------------------------------------------
# These are Firebase Secret Manager values used by functions/, never by the
# browser. Set them once per project with:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set TEACHER_SIGNUP_CODE
#
# For the emulator, put them in functions/.secret.local (gitignored):
#
#   ANTHROPIC_API_KEY=sk-ant-api03-…
#   TEACHER_SIGNUP_CODE=let-me-teach
#
# CLAUDE_MODEL is an optional env override for the evaluator model; it defaults
# to claude-opus-5 and is also read only by the functions.
