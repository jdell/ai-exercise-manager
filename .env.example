# ---------------------------------------------------------------------------
# AI Skills Exercise Manager — environment configuration
# Copy to `.env.local` and fill in. Every VITE_* value is embedded in the built
# JavaScript bundle and is therefore PUBLIC. Never put a secret here that you
# would not hand to anyone who loads the page.
# ---------------------------------------------------------------------------

# --- Firebase Realtime Database ---------------------------------------------
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup
VITE_FIREBASE_API_KEY=AIzaSyEXAMPLE-replace-with-your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Anthropic Claude API ---------------------------------------------------
# OPTIONAL and NOT RECOMMENDED for anything but a local classroom demo.
# Baking a key here ships it to every browser that loads the app. Leave it
# blank and let each user paste their own key in Settings (stored in that
# browser's localStorage only), or front the API with your own proxy.
# Get a key at https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# Model used by the Claude Evaluator. Defaults to claude-opus-5.
VITE_CLAUDE_MODEL=claude-opus-5

# --- Teacher access ---------------------------------------------------------
# Passcode required to sign in as Teacher or Claude Evaluator. This is a
# soft gate for classroom use, not real authentication — it is visible in the
# bundle. Use Firebase Auth + database rules if you need real access control.
VITE_TEACHER_PASSCODE=let-me-teach
