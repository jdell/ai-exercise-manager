# ──────────────────────────────────────────────
# Prompt Class — Environment Variables
# Copy this file to .env.local and fill in values. Next.js and the Prisma CLI
# (via prisma.config.ts) both read .env.local.
# NEVER commit .env or .env.local to git
# ──────────────────────────────────────────────

# Supabase
# The values below are for the local stack started with `npm run db:start`.
# They are the Supabase CLI's public demo keys — safe to share, useless off localhost.
# For staging/production, get them from: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-only. Needed later for admin tasks such as inviting candidates.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Database
# Locally both point at the Supabase Postgres container (port 54322).
# Hosted Supabase:
#   DATABASE_URL → Transaction pooler (port 6543, add ?pgbouncer=true) — app runtime / serverless
#   DIRECT_URL   → Session pooler (port 5432)                          — Prisma CLI (db push)
#   Find both under: Supabase → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Anthropic — used to score submissions and generate reports (not wired up yet)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
