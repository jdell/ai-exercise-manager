# ──────────────────────────────────────────────
# Prompt Class — Environment Variables
# Copy this file to .env.local (Next.js) and .env (Prisma CLI) and fill in values
# NEVER commit .env or .env.local to git
# ──────────────────────────────────────────────

# Supabase — get from: supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed later for admin tasks such as inviting candidates.
SUPABASE_SERVICE_ROLE_KEY=

# Database — Supabase PostgreSQL connection strings
# DATABASE_URL → Transaction pooler (port 6543) — app runtime / serverless
# DIRECT_URL   → Session pooler (port 5432)    — Prisma CLI (db push, migrations)
# Find both under: Supabase → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Anthropic — used to score submissions and generate reports (not wired up yet)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
