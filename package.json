{
  "name": "ai-exercise-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI Skills Exercise Manager — student prompt exercises auto-scored by Claude, reviewed by teachers.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit && npm run lint:functions",
    "lint:functions": "tsc -p functions/tsconfig.json --noEmit",
    "emulators": "npm --prefix functions run build && firebase emulators:start --only auth,database,functions",
    "deploy": "npm run build && firebase deploy",
    "postinstall": "npm --prefix functions install --no-audit --no-fund"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
